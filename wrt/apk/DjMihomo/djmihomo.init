#!/bin/sh /etc/rc.common
# DjMihomo v1.2.18.50 - Mihomo 控制台 (Nikki 风格 + AnGe 面板)
# 启动: /etc/init.d/djmihomo start|stop|restart|enable|disable

START=99
STOP=10
USE_PROCD=1

APP_DIR="/usr/share/djmihomo"
DATA_DIR="/etc/djmihomo"
CONSOLE_PORT=9091

start_service() {
	# 未启用时不启动 (与飞牛版行为一致: app.json enabled=false 或存在 disabled 标记)
	if [ -f "$DATA_DIR/disabled" ]; then
		logger -t djmihomo "service disabled, skip starting"
		return 0
	fi
	if [ -f "$DATA_DIR/app.json" ] && grep -q '"enabled": *false' "$DATA_DIR/app.json"; then
		logger -t djmihomo "service disabled in app.json, skip starting"
		return 0
	fi
	procd_open_instance
	procd_set_param command "$APP_DIR/bin/djconsole"
	procd_set_param env DJMIHOMO_DATA="$DATA_DIR" DJMIHOMO_BIN="$APP_DIR/bin/mihomo" DJMIHOMO_CONSOLE_PORT="$CONSOLE_PORT"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 先停控制台, 再停核心 (核心是控制台的子进程, 正常会一起退出)
	killall djconsole 2>/dev/null || true
	sleep 1
	killall mihomo 2>/dev/null || true
}
